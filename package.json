{
  "name": "interview-copilot",
  "version": "1.8.4",
  "private": true,
  "description": "Copilot · AI 面试副驾（Web + 桌面端）",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start -p 3300",
    "check:qa": "tsc lib/qaMatch.ts lib/types.ts scripts/qa-match-check.ts --outDir .tmp-qa-build --module commonjs --target es2020 --moduleResolution node --esModuleInterop --skipLibCheck && node .tmp-qa-build/scripts/qa-match-check.js",
    "check:qa:adv": "tsc lib/qaMatch.ts lib/types.ts scripts/qa-adversarial-check.ts --outDir .tmp-qa-adv --module commonjs --target es2020 --moduleResolution node --esModuleInterop --skipLibCheck && node .tmp-qa-adv/scripts/qa-adversarial-check.js",
    "check:asr": "tsc lib/asrStream.ts scripts/asr-stream-check.ts --outDir .tmp-asr-build --module commonjs --target es2020 --moduleResolution node --esModuleInterop --skipLibCheck && node .tmp-asr-build/scripts/asr-stream-check.js",
    "desktop:build": "node scripts/build-standalone.mjs && node scripts/prepare-standalone.mjs",
    "desktop": "node scripts/prepare-standalone.mjs && node scripts/launch-desktop.mjs",
    "desktop:dist": "npm run desktop:build && electron-builder --win nsis --config.electronDist=node_modules/electron/dist",
    "desktop:portable": "npm run desktop:build && electron-builder --win dir --config.electronDist=node_modules/electron/dist",
    "release:local": "npm run desktop:dist && node scripts/publish-local.mjs"
  },
  "build": {
    "appId": "com.interview.copilot",
    "productName": "面试副驾",
    "asar": false,
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app"
      }
    ],
    "win": {
      "icon": "electron/app-icon.ico",
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "面试副驾",
      "artifactName": "面试副驾-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "idb": "^8.0.2",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.8.0",
    "next": "14.2.33",
    "pdfjs-dist": "^4.8.69",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
